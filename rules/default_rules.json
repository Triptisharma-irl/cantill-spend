    "NOT_APPROVED": [
      "reject",
      "rejected",
      "declined",
      "on hold",
      "hold",
      "held",
      "blocked",
      "parked",
      "disputed",
      "dispute",
      "in dispute",
      "query",
      "queried",
      "submitted",
      "pending",
      "pending approval",
      "awaiting approval",
      "draft",
      "open",
      "new",
      "in review",
      "under review",
      "unapproved",
      "not approved",
      "workflow",
      "suspended",
      "exception"
    ],
    "unknown_policy": "NOT_APPROVED",
    "blank_policy": "ok"
  },
  "non_procurement": [
    {
      "name": "intercompany",
      "fields": [
        "gl_desc",
        "supplier_type_desc",
        "description",
        "supplier_name",
        "document_type_desc"
      ],
      "regex": "\\b(inter[\\s-]?company|intra[\\s-]?group|intercompañia|interco|i/c\\b|ic\\s+payables?|ic\\s+receivables?|related[\\s-]party)"
    },
    {
      "name": "intercompany_gl_code",
      "fields": [
        "gl_desc"
      ],
      "regex": "^\\s*(IC|I/C)[\\s-]?\\d{1,3}\\s*$"
    },
    {
      "name": "tax_charge",
      "fields": [
        "description",
        "gl_desc"
      ],
      "regex": "^\\s*(accrued[\\s-]*)?(((state|local|sales|use|gst|hst|pst|qst|vat|value[\\s-]added|withholding|wht|input|output|excise|property|municipal|income|corporate|payroll|stamp|franchise|business|service)\\s*[&/,\\-]?\\s*(and\\s+)?)+(tax|taxes)\\b|(tax|taxes|vat|gst|iva|tva|mwst|impuesto|imposto)\\s*([0-9.,%]+\\s*)?(-|$|expense|payable|charge|amount|input|output))",
      "unless": "consult|advis|service|prep|work|software|filing fee|assistance|credit study"
    },
    {
      "name": "payroll",
      "fields": [
        "description",
        "gl_desc"
      ],
      "regex": "\\b(salar(y|ies)|wages?\\b|payroll(?!\\s+services?)|net pay|pension contribution|social security|garnish)"
    },
    {
      "name": "finance",
      "fields": [
        "description",
        "gl_desc"
      ],
      "regex": "\\b(interest (expense|charge|paid|payable|on)|loan repayment|loan principal|bank (charges?|fees?)|finance charges?|financing (cost|fee)s?|dividends?|fx (loss|gain)|exchange (loss|gain|difference)|forex (loss|gain)|depreciation|amorti[sz]ation|lease liability)\\b"
    },
    {
      "name": "royalty_partner",
      "fields": [
        "description",
        "gl_desc"
      ],
      "regex": "\\b(royalt(y|ies)|partner (billing|payout|share|distribution)s?|revenue share|profit share|commission payable|franchise fee)\\b"
    },
    {
      "name": "revenue_refund",
      "fields": [
        "gl_desc"
      ],
      "regex": "\\b(revenue|sales income|customer refund|deferred income)\\b"
    },
    {
      "name": "government",
      "fields": [
        "description",
        "gl_desc"
      ],
      "regex": "\\b(fines?|penalt(y|ies)|government levy|statutory levy|donation|charitable contribution)\\b",
      "unless": "fine[\\s-]?(grain|mesh|thread|tune|filter|blade|pitch)|very fine|fine$"
    }
  ],
