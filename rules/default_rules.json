{
  "_comment": "Generic, company-independent rules. No category names live here: only vocabulary about statuses, non-procurement money flows, legal-entity suffixes and common purchasing abbreviations. Company configs can extend or override every list.",
  "status": {
    "ok": [
      "paid",
      "approved",
      "posted",
      "cleared",
      "complete",
      "completed",
      "closed",
      "settled",
      "released",
      "processed",
      "authorised",
      "authorized",
      "accepted",
      "booked",
      "ok",
      "valid",
      "active",
      "invoiced",
      "partially paid",
      "part paid",
      "partly paid",
      "scheduled for payment",
      "ready for payment"
    ],
    "CANCELLED": [
      "cancel",
      "cancelled",
      "canceled",
      "cancellation",
      "void",
      "voided",
      "reversed",
      "reversal",
      "deleted",
